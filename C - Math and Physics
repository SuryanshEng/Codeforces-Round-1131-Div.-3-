#include <bits/stdc++.h>
using namespace std;
int main(){
    ios::sync_with_stdio(0);
    cin.tie(0);
    int T; cin >> T;
    while(T--){
        int N; cin >> N;
        vector<int> A(N);
        long long S = 0; int MX = 0,MXI = 0;
        for(int i = 0; i < N; i++) {
            cin >> A[i]; S += A[i]; MX = max(MX,A[i]);
        }
        for(int i = 1; i + 1 < N; i++) MXI = max(MXI,A[i]);
        if(MX < 2) cout << -1 << "\n";
        else if(MXI >= 2) cout << S-1 << "\n";
        else cout << S - (N-1) << "\n";
    }
}
